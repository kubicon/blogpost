---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
// The abstract lives in frontmatter, so render its markdown (links etc.) separately.
const markdown = await createMarkdownProcessor();
const abstractHtml = project.data.abstract?.trim()
	? (await markdown.render(project.data.abstract)).code
	: undefined;
---

<Layout
	title={project.data.title}
	description={project.data.description}
	pubDate={project.data.pubDate}
	updatedDate={project.data.updatedDate}
>
	{
		abstractHtml && (
			<section class="abstract" slot="abstract">
				<h2>Abstract</h2>
				<Fragment set:html={abstractHtml} />
			</section>
		)
	}
	<h2 class="notes-heading">Research notes</h2>
	<Content />
</Layout>

<style>
	.abstract {
		max-width: 80%;
		margin: 0 auto 1.5em auto;
		line-height: 1.6;
		text-align: justify;
	}
	.abstract h2 {
		font-size: 1em;
		text-align: center;
		margin: 0 0 0.5em 0;
	}
	.abstract :global(p) {
		font-size: 0.9em;
		margin: 0.5em 0 0 0;
	}
	.notes-heading {
		font-size: 1.25em;
		margin: 0 0 1em 0;
	}
	@media (max-width: 720px) {
		.abstract {
			max-width: 100%;
		}
	}
</style>
