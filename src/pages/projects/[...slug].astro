---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
const abstractParagraphs = project.data.abstract
	?.split(/\n\s*\n/)
	.map((paragraph) => paragraph.trim())
	.filter(Boolean);
---

<Layout
	title={project.data.title}
	description={project.data.description}
	pubDate={project.data.pubDate}
	updatedDate={project.data.updatedDate}
>
	{
		abstractParagraphs && abstractParagraphs.length > 0 && (
			<section class="abstract" slot="abstract">
				<h2>Abstract</h2>
				{abstractParagraphs.map((paragraph) => <p>{paragraph}</p>)}
			</section>
		)
	}
	<h2 class="notes-heading">Research notes</h2>
	<Content />
</Layout>

<style>
	.abstract {
		max-width: 80%;
		margin: 0 auto 1.5em auto;
		line-height: 1.6;
		text-align: justify;
	}
	.abstract h2 {
		font-size: 1em;
		text-align: center;
		margin: 0 0 0.5em 0;
	}
	.abstract p {
		font-size: 0.9em;
		margin: 0.5em 0 0 0;
	}
	.notes-heading {
		font-size: 1.25em;
		margin: 0 0 1em 0;
	}
	@media (max-width: 720px) {
		.abstract {
			max-width: 100%;
		}
	}
</style>
