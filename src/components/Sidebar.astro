---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<aside class="sidebar">
	<h2><a href="/about">About Me</a></h2>
	<details class="projects">
		<summary>Projects</summary>
		<ul>
			{
				projects.map((project) => (
					<li>
						<a href={`/projects/${project.id}/`}>{project.data.title}</a>
					</li>
				))
			}
		</ul>
	</details>
</aside>
<style>
	.sidebar {
		width: 200px;
		flex-shrink: 0;
	}
	.sidebar h2,
	.projects summary {
		font-size: 1.1em;
		font-weight: bold;
		line-height: 1.2;
		margin: 0 0 1em 0;
	}
	.sidebar h2 a {
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}
	.sidebar h2 a:hover {
		color: var(--accent);
	}
	.projects summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		list-style: none;
	}
	.projects summary::-webkit-details-marker {
		display: none;
	}
	.projects summary::marker {
		content: '';
	}
	.projects summary::after {
		content: '▸';
		display: inline-block;
		margin-left: 0.4em;
		transition: transform 0.15s ease;
	}
	.projects[open] summary::after {
		transform: rotate(90deg);
	}
	.sidebar ul {
		list-style: none;
		margin: 0.75em 0 0 0;
		padding: 0 0 0 1.1em;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	.sidebar a {
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}
	.sidebar a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.sidebar {
			width: 100%;
		}
	}
</style>
